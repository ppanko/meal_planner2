# Public browser values. These are safe to expose in a static GitHub Pages build.
# Security is enforced by Supabase Row Level Security, not by hiding these values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Comma-separated. This is only a client-side UX guard; repeat the same two
# addresses in supabase/setup.sql because RLS is the real authorization layer.
VITE_ALLOWED_EMAILS=person1@example.com,person2@example.com

# Both devices must use the same state ID. Usually leave this as household.
VITE_SUPABASE_STATE_ID=household
